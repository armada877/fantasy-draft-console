# ─────────────────────────────────────────────────────────────
# Keep the reusable framework tracked; keep everything specific to
# YOUR league, your analysis, your data, and your secrets LOCAL.
# ─────────────────────────────────────────────────────────────

# ── Your local config (briefing, secrets, league registry) — keep everything
#    except the templates/README ──
/config/*
!/config/*.example
!/config/*.example.*
!/config/README.md

# ── Secrets & credentials ──
**/.env
**/.env.local
!**/.env.example
scraping/.espn_auth.json
api_key.txt
*.pem

# ── Scraped league data (re-generate from your own ESPN account) ──
scraping/raw/
scraping/har_extracted/
*.har

# ── Projection sheets & derived data (source-specific / copyrighted) ──
draft_sheets/*.xlsm
draft_sheets/*.xlsx
draft_sheets/*.csv
# …but DO track the universal Elboberto baseline projections workbook (checked in):
!draft_sheets/*_elboberto.xlsm
draft_sheets/elboberto_projections.json
draft_sheets/tool_data.json

# ── Generated app payload (built by the inject/board steps from the templates) ──
draft_app/static/index.html
draft_app/static/data.json
draft_app/static/board.html

# ── Manage board (fftiers): league YAMLs name real leagues; dat/ and out/ are
#    fetched/derived data. Only the commented example league config is tracked. ──
/leagues/*
!/leagues/example-standard-12.yaml
/dat/
/out/

# ── Analysis: the pipeline CODE is tracked; league-specific identity lives in
#    config/ (manager_canon.json / league.json / boards.json). Only the ANALYSIS
#    OUTPUTS and private notes stay local. ──
reports/
league/
draft_app/eval_report.md

# ── Python env & caches ──
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/

# ── Local tooling / scratch / OS ──
.claude/
.playwright-mcp/
review-*.png
.DS_Store

# CSG sheet (third-party) + its extracted consensus data — local only
draft_sheets/csg_consensus.json

# ── Working docs built from YOUR leagues ──
# Same rule as reports/: the reusable CODE is tracked, anything naming your leagues,
# their ids, managers or team names stays local. Adding a doc to docs/ (not
# docs/local/) is a decision to publish it: the remote is public.
docs/local/

.vercel/
