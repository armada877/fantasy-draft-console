# Copy this file to config/.env and fill in your values, then load it before running:
#   set -a && . config/.env && set +a
# (config/.env is gitignored — it never leaves your machine.)

# Advisor (required for the LLM advisor; the console works without it)
ANTHROPIC_API_KEY=sk-ant-...

# ESPN (draft scraping + manage `pull`). Grab these two cookies from a logged-in
# fantasy.espn.com session. Alternatively put them in scraping/.espn_auth.json.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=...

# FantasyPros consensus ranks (manage `pull`; without it cached ranks are reused).
FANTASYPROS_API_KEY=...

# Board snapshot store (optional; Supabase). The manage `board` stage pushes each
# build here and the server's /api/board-data reads the latest, so the deployed app
# updates without a redeploy. All three must be set; otherwise pushes are skipped
# and the server falls back to out/board/viz-data.json.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_API_KEY=sb_publishable_...
BOARD_DB_SECRET=...
