# Copy this file to config/.env and fill in your values, then load it before running:
#   set -a && . config/.env && set +a
# (config/.env is gitignored — it never leaves your machine.)

# Advisor (required for the LLM advisor; the console works without it)
ANTHROPIC_API_KEY=sk-ant-...

# ESPN scraping (only if you re-scrape league data). Grab these two cookies from a
# logged-in fantasy.espn.com session. Alternatively put them in scraping/.espn_auth.json.
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_S2=...
